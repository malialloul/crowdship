# Copy to .env.local
# Local: values printed by `supabase start` (API URL + anon / publishable key)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

VITE_APP_NAME=Crowdship

# Shows the "Start a test hold" form on /payments outside `npm run dev`
# (e.g. on a staging deploy). Leave false in production.
VITE_ENABLE_TEST_HOLDS=false
