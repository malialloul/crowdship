# Copy to supabase/functions/.env for local `supabase functions serve --env-file`.
# For hosted projects: `supabase secrets set --env-file supabase/functions/.env`
# or paste each line in Dashboard → Edge Functions → Secrets.
# (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected automatically.)

# Frontend origin — used for Whish redirect URLs and CORS.
APP_URL=http://localhost:5173

# "mock" = simulated checkout page, no real money (local dev only).
# "live" = real Whish Pay API (sandbox or production base URL below).
WHISH_MODE=mock

# Issued by Whish with your merchant account.
# Sandbox:    https://lb.sandbox.whish.money/itel-service/api
# Production: https://whish.money/itel-service/api
WHISH_BASE_URL=https://lb.sandbox.whish.money/itel-service/api
WHISH_CHANNEL=
WHISH_SECRET=
WHISH_WEBSITE_URL=

# Random 32+ char string; signs the callback URL. e.g. `openssl rand -hex 32`
WHISH_CALLBACK_SECRET=change-me-to-a-long-random-string

# Public URL Whish can reach for callbacks. Locally, expose functions with a
# tunnel (ngrok / cloudflared) and put that URL here. Hosted projects can omit.
# PUBLIC_FUNCTIONS_URL=https://<tunnel>.ngrok.app/functions/v1

# Smart product search (serper.dev API key).
SERPER_API_KEY=
